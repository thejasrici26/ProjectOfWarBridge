WARBRIDGE_ENV=development
SECRET_KEY=replace-with-a-private-random-value
HTTPS_ONLY=0

# Local SQLite is the default. Set only one PostgreSQL URL when selecting PostgreSQL.
WARBRIDGE_DB=.\warbridge-demo.db
WARBRIDGE_DATABASE_URL=
WARBRIDGE_DEVELOPMENT_DATABASE_URL=
WARBRIDGE_TEST_DATABASE_URL=
WARBRIDGE_DB_POOL_SIZE=5
WARBRIDGE_DB_CONNECTION_TIMEOUT=10
WARBRIDGE_ADMIN_EMAIL=
WARBRIDGE_ADMIN_PASSWORD=

# Security and observability
WARBRIDGE_MAX_CONTENT_LENGTH=1048576
WARBRIDGE_LOG_LEVEL=INFO
WARBRIDGE_METRICS_TOKEN=
CORS_ALLOWED_ORIGINS=
FRAME_ANCESTORS="'none'"
SESSION_COOKIE_SAMESITE=Lax

# Provider adapters stay disabled unless explicitly enabled for local development.
WARBRIDGE_VERIFICATION_PROVIDER=disabled
WARBRIDGE_EMERGENCY_PROVIDER=disabled
WARBRIDGE_SOS_ESCALATION_TIMEOUT_SECONDS=900
WARBRIDGE_EMERGENCY_EMAIL_RECIPIENT=
WARBRIDGE_EMERGENCY_SMS_RECIPIENT=
WARBRIDGE_EMERGENCY_WHATSAPP_RECIPIENT=
WARBRIDGE_EMERGENCY_PUSH_NOTIFICATION_RECIPIENT=

# Backup options (the backup tool is SQLite-only)
WARBRIDGE_BACKUP_DIR=
WARBRIDGE_BACKUP_LOG=
WARBRIDGE_BACKUP_RETENTION_DAYS=30
WARBRIDGE_BACKUP_RETENTION_COUNT=14
WARBRIDGE_BACKUP_ENCRYPTION_KEY=
